# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/opportunity-hub-2?retryWrites=true&w=majority

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRE=30d

# ── Email (Ethereal for dev — https://ethereal.email) ────────────────────────
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_user@ethereal.email
EMAIL_PASS=your_ethereal_password
EMAIL_FROM=noreply@opportunityhub2.dev

# ── For Gmail (swap values above) ────────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your_app_password

# ── Client URL ────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ── Admin Seed ───────────────────────────────────────────────────────────────
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@opportunityhub2.dev
ADMIN_PASSWORD=Admin@1234
